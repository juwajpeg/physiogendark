# ======================================================================
# Physiogen Environment Variables Template (.env.example)
# Copy this file to .env.local and replace with your actual keys
# ======================================================================

# --- Supabase Database & Auth ---
# Obtain from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Cloudinary Image Storage ---
# Obtain from: https://cloudinary.com -> Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Admin Panel Authentication ---
ADMIN_EMAIL=admin@physiogen.fit
ADMIN_PASSWORD=your_secure_admin_password
