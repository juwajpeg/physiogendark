# ======================================================================
# Physiogen Web Platform - Git Ignore Rules
# ======================================================================

# --- Dependencies & Package Managers ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Environment Variables & Sensitive Credentials (CRITICAL) ---
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
credentials.json
.credentials
*.key
*.pem
*.cert
*.crt
service-account*.json
.gitconfig

# --- Next.js Build & Outputs ---
/.next/
/out/
/build/
/dist/
.vercel
*.tsbuildinfo
next-env.d.ts

# --- Testing & Quality Assurance ---
/coverage
/test_reports/
.nyc_output
*.lcov

# --- Logs & Debugging ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Agent & Development Scratch Artifacts ---
.emergent/
/memory/
/scratch/
*.tmp
*.bak
*.swp
*.swo

# --- Office & Client Requirement Documents ---
*.docx
*.xlsx
*.pptx
Admin_Panel_Requirements_Document.docx

# --- IDE & Code Editor Configurations ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
